{
  "version": 1,
  "name": "example-gitea",
  "host": "example-host",
  "source": {
    "type": "gitea-git",
    "apiUrl": "https://git.example.com",
    "tokenFile": "/secrets/gitea-token"
  },
  "backupDrive": {
    "sentinelFile": "/backups/.sentinel",
    "driveSerial": "example-drive",
    "filesystemUuid": "example-filesystem"
  },
  "destinations": [
    {
      "type": "restic",
      "repository": "/backups/restic",
      "passwordFile": "/secrets/restic-password"
    }
  ],
  "retention": { "daily": 14, "weekly": 8, "monthly": 12, "yearly": 5 },
  "schedule": { "cron": "30 3 * * *", "timeZone": "UTC" }
}
