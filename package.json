  "dependencies": {
    "@effect/platform-node": "4.0.2",
    "effect": "4.0.2"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.1.0",
    "vite-plus": "1.1.0",
    "vitest": "5.0.3"
  },
  "engines": {
    "node": "^24.21.0"
  },
  "packageManager": "pnpm@11.25.0"
}
