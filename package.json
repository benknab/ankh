{
  "name": "backup-runner",
  "version": "0.1.0",
  "private": true,
  "description": "Database and Git backups with Restic and Proton Drive",
  "homepage": "https://github.com/benknab/backup-runner#readme",
  "bugs": {
    "url": "https://github.com/benknab/backup-runner/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/benknab/backup-runner.git"
  },
  "type": "module",
  "scripts": {
    "start": "node main.ts",
    "check": "pnpm fmt:check && pnpm lint && pnpm typecheck",
    "fmt": "vp fmt",
    "fmt:check": "vp fmt --check",
    "lint": "vp lint --deny-warnings",
    "typecheck": "tsc --noEmit",
    "test": "pnpm test:unit",
    "test:unit": "vp test run --configLoader native --project unit",
    "test:integration": "bash tools/test-integration.sh",
    "test:integration:run": "vp test run --configLoader native --cache=false --project integration",
    "test:all": "pnpm test:unit && pnpm test:integration",
    "prepare": "effect-tsgo patch --no-typescript --oxlint"
  },
  "dependencies": {
    "@effect/platform-node": "4.0.2",
    "effect": "4.0.2"
  },
  "devDependencies": {
    "@effect/tsgo": "0.53.1",
    "@effect/vitest": "4.0.2",
    "@types/node": "24.19.2",
    "oxlint": "1.87.0",
    "oxlint-tsgolint": "7.0.2003",
    "typescript": "7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.1.0",
    "vite-plus": "1.1.0",
    "vitest": "5.0.3"
  },
  "engines": {
    "node": "24.22.1",
    "pnpm": ">=12.0.0"
  },
  "packageManager": "pnpm@12.15.0"
}
