[Unit]
Description=Back up opted-in Deployment services
RequiresMountsFor=/mnt/backup-drive
After=docker.service mnt-backup\x2ddrive.mount
Wants=docker.service

[Service]
Type=oneshot
User=example-host
Group=example-host
WorkingDirectory=/home/backup/deployment/backup-runner
ExecStart=/home/backup/.deno/bin/deno run --allow-all main.ts run-all /home/backup/deployment
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
